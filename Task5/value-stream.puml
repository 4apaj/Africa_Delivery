@startuml value-stream
title Africa Delivery — Value Stream «От рекламы до денег продавца» с нанесёнными capabilities
skinparam defaultFontName Arial
skinparam rectangle {
  RoundCorner 8
  FontSize 11
}
skinparam rectangle<<stage>> {
  BackgroundColor #1F3864
  FontColor #FFFFFF
  FontStyle bold
  FontSize 13
}
skinparam rectangle<<build>> {
  BackgroundColor #E3F4EA
  BorderColor #0B7A4B
}
skinparam rectangle<<buy>> {
  BackgroundColor #FFF4E5
  BorderColor #C77700
}
skinparam rectangle<<partner>> {
  BackgroundColor #E8F1FB
  BorderColor #1F5FA8
}
skinparam rectangle<<later>> {
  BackgroundColor #EEEEEE
  BorderColor #999999
  FontColor #666666
}

left to right direction

rectangle "Покупатель: 1. Привлечь" <<stage>> as s1
rectangle "2. Найти товар" <<stage>> as s2
rectangle "3. Заказать и оплатить" <<stage>> as s3
rectangle "4. Доставить" <<stage>> as s4
rectangle "5. Получить / вернуть" <<stage>> as s5
rectangle "6. Рассчитаться с продавцом" <<stage>> as s6

s1 -[#1F3864,thickness=3]-> s2
s2 -[#1F3864,thickness=3]-> s3
s3 -[#1F3864,thickness=3]-> s4
s4 -[#1F3864,thickness=3]-> s5
s5 -[#1F3864,thickness=3]-> s6

together {
rectangle "1.5 Маркетинг по согласию\n(opt-in USSD/SMS)" <<build>> as c15
rectangle "1.1 Идентификация и согласия" <<build>> as c11
rectangle "1.3 Приложение (Flutter)\nдиплинки из рекламы" <<build>> as c13
rectangle "Live-стрим\n(внешняя платформа)" <<partner>> as cls
}
rectangle "1.2 Поиск и каталог" <<build>> as c12
rectangle "2.1 Товарная информация" <<build>> as c21
rectangle "1.6 Локализация (Weblate)" <<buy>> as c16
rectangle "2.2–2.4 Цены, флеш-распродажи,\nкорзина, заказы, остатки" <<build>> as c22
rectangle "3.1 Оркестратор платежей" <<build>> as c31
rectangle "PSP: M-Pesa Daraja,\nFlutterwave, Paystack" <<partner>> as cpsp
rectangle "3.5 Антифрод: правила + скоринг PSP" <<partner>> as c35
rectangle "4.1 Отправления: Sendbox, Sendy" <<partner>> as c41
rectangle "4.3 Адресация: Plus Codes + ориентир" <<build>> as c43
rectangle "1.4 Уведомления\n(WhatsApp/SMS/push — партнёры)" <<build>> as c14
rectangle "4.2 Отслеживание по статусам" <<build>> as c42
rectangle "3.3 Возврат кредитом на баланс" <<build>> as c33
rectangle "6.4 Споры и возвраты (бэк-офис)" <<buy>> as c64
rectangle "4.4 ПВЗ, 4.5 обратная логистика\n(месяц 6–12)" <<later>> as c44
rectangle "3.2 Выплаты в тот же день\n(B2C, Transfers)" <<partner>> as c32
rectangle "3.4 Сверка" <<build>> as c34
rectangle "7.1 Дашборд руководства" <<build>> as c71

s1 --> c15
s1 --> c11
s1 --> c13
s1 --> cls
s2 --> c12
s2 --> c21
s2 --> c16
s3 --> c22
s3 --> c31
s3 --> cpsp
s3 --> c35
s4 --> c41
s4 --> c43
s4 --> c14
s5 --> c42
s5 --> c33
s5 --> c64
s5 --> c44
s6 --> c32
s6 --> c34
s6 --> c71

rectangle "Продавец: A. Подключиться" <<stage>> as p1
rectangle "B. Разместить товар" <<stage>> as p2
rectangle "C. Подтвердить заказ" <<stage>> as p3
p1 -[#1F3864,thickness=3]-> p2
p2 -[#1F3864,thickness=3]-> p3
p3 -[#1F3864,thickness=3]-> s6

rectangle "5.1 Онбординг и KYC\n(вручную в MVP, Smile ID — Год 1)" <<build>> as c51
rectangle "6.2 Модерация, 6.3 верификация\n(конструктор админок)" <<buy>> as c62
rectangle "5.2 Заказы в WhatsApp (BSP)" <<build>> as c52
rectangle "6.1 Резидентность ПДн (сквозная)" <<build>> as c61
p1 --> c51
p2 --> c62
p3 --> c52
p1 --> c61

legend right
  |= Цвет |= Решение |
  |<#E3F4EA> | Build |
  |<#FFF4E5> | Buy (продукт / OSS) |
  |<#E8F1FB> | Partner |
  |<#EEEEEE> | После MVP |
endlegend
@enduml
